PORT=5000

# REQUIRED for hosting: the password staff use to log in to the website.
APP_PASSWORD=

# Optional extra secret for login tokens. Changing it logs everyone out.
AUTH_SECRET=

# STRONGLY recommended for hosting. If empty, data is saved in data/db.json,
# which most hosting platforms erase on every restart/redeploy.
MONGODB_URI=

# Time zone used for "today" on the server.
TIME_ZONE=Asia/Kolkata

# Only needed if the frontend is hosted on a different domain than the backend.
# Example: CORS_ORIGIN=https://vasu-frontend.netlify.app
CORS_ORIGIN=
